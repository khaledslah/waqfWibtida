{
  "$comment": "NEW trial raw schema (does not replace grilled raw_waqf_output.schema.json). Same waqf core + nullable verdict + optional margin_comments on that bracket only. No verdict_status / resolution fields.",
  "type": "object",
  "required": ["page_numbers", "waqfs"],
  "properties": {
    "page_numbers": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "waqfs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ayah",
          "target_word",
          "verdict_label",
          "verdict",
          "text",
          "text_page",
          "old_text",
          "fixes",
          "margin_comments"
        ],
        "additionalProperties": false,
        "properties": {
          "ayah": { "type": "integer" },
          "target_word": { "type": "string" },
          "verdict_label": {
            "type": ["string", "null"],
            "enum": ["ط", "م", "ج", "ز", "ص", "لا", "ق", null]
          },
          "verdict": {
            "type": ["string", "null"],
            "enum": ["تام", "لازم", "جائز", "حسن", "لا يوقف", "قيل فيه وقف", null]
          },
          "text": { "type": "string" },
          "text_page": { "type": "integer" },
          "old_text": { "type": ["string", "null"] },
          "fixes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "basis", "old_text", "new_text", "info"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "page_split",
                    "missing_delimiter",
                    "missing_symbol",
                    "orthography",
                    "ayah_number_correction",
                    "malformed_bracket"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": ["page_prose", "editor_policy"]
                },
                "old_text": { "type": "string" },
                "new_text": { "type": "string" },
                "info": { "type": "string" }
              }
            }
          },
          "margin_comments": {
            "type": "array",
            "description": "Only margin/footnote notes that comment on THIS waqf bracket. Empty [] if none.",
            "items": {
              "type": "object",
              "required": ["text", "text_page"],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Literal margin note text relevant to this bracket"
                },
                "text_page": {
                  "type": "integer",
                  "description": "Printed page where the margin note appears"
                },
                "scholar_or_work": {
                  "type": ["string", "null"],
                  "description": "Optional name if the note cites a scholar/work/manuscript witness; else null"
                }
              }
            }
          }
        }
      }
    }
  },
  "verdict_mapping": {
    "ط": "تام",
    "م": "لازم",
    "ج": "جائز",
    "ز": "جائز",
    "ص": "حسن",
    "لا": "لا يوقف",
    "ق": "قيل فيه وقف"
  },
  "rules": [
    "If verdict_label non-null: verdict MUST equal verdict_mapping[verdict_label]",
    "If unresolved (no letter): verdict_label=null AND verdict=null — still emit the waqf if the bracket exists",
    "Do NOT invent a letter from Quran logic; missing_symbol only with basis=page_prose",
    "margin_comments: ONLY notes that comment on this bracket; never dump unrelated footnotes",
    "margin_comments=[] when margin is silent on this waqf",
    "No verdict_status / verdict_resolution fields"
  ]
}
