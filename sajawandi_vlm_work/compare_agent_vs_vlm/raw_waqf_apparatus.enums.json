{
  "$comment": "Canonical enums for raw_waqf_apparatus.schema.json",
  "schema": "raw_waqf_apparatus.schema.json",
  "verdict_label": ["ط", "م", "ج", "ز", "ص", "لا", "ق"],
  "verdict_label_nullable": true,
  "verdict": ["تام", "لازم", "جائز", "حسن", "لا يوقف", "قيل فيه وقف"],
  "verdict_nullable": true,
  "verdict_mapping": {
    "ط": "تام",
    "م": "لازم",
    "ج": "جائز",
    "ز": "جائز",
    "ص": "حسن",
    "لا": "لا يوقف",
    "ق": "قيل فيه وقف"
  },
  "scholar": [
    "ابن الأنباري",
    "النحاس",
    "الداني",
    "الأشموني",
    "الأخفش",
    "الكسائي",
    "مكي",
    "العكبري",
    "الأنصاري",
    "الطبري",
    "ابن عطية",
    "unknown"
  ],
  "scholar_alias_hints": {
    "ابن الأنباري": ["أبي البركات ابن الأنباري", "ابن الانباري", "الأنباري"],
    "النحاس": ["أبي جعفر النحاس", "النحّاس"],
    "الداني": ["أبي عمرو الداني", "أبو عمرو الداني"],
    "الأشموني": ["الاشموني", "أحمد بن محمد الأشموني"],
    "الأخفش": ["الأخفش الأوسط", "الاخفش"],
    "مكي": ["مكي بن أبي طالب", "مكي القيسي"],
    "العكبري": ["أبي البقاء العكبري", "العكبرى"],
    "الأنصاري": ["زكريا الأنصاري", "شيخ الإسلام الأنصاري"],
    "الطبري": ["محمد بن جرير الطبري", "ابن جرير"],
    "ابن عطية": ["القاضي ابن عطية", "أبي محمد ابن عطية"]
  },
  "margin_ref": {
    "type": ["integer", "null"],
    "description": "Footnote number on/after closing bracket; null if unnumbered"
  },
  "fix_type": [
    "page_split",
    "missing_delimiter",
    "missing_symbol",
    "orthography",
    "ayah_number_correction",
    "malformed_bracket"
  ],
  "fix_basis": ["page_prose", "editor_policy"],
  "symbol_witness_basis": ["page_prose"],
  "opinion_verdict_examples": [
    "تام",
    "كاف",
    "حسن",
    "جائز",
    "لازم",
    "لا يوقف",
    "قبيح"
  ],
  "waqf_required_fields": [
    "ayah",
    "target_word",
    "verdict_label",
    "verdict",
    "margin_ref",
    "text",
    "text_page",
    "old_text",
    "fixes",
    "apparatus"
  ],
  "apparatus_item_required_fields": ["margin_ref", "text_page", "opinions"],
  "opinion_required_fields": ["scholar", "verdict"],
  "consistency_rules": [
    "apparatus only when waqf.margin_ref != null AND margin has the same number",
    "waqf.margin_ref null → apparatus []",
    "apparatus[].margin_ref must equal waqf.margin_ref",
    "one opinions[] row per scholar",
    "opinion.verdict = final word (حسن/كاف/تام/…), never a letter",
    "opinion.scholar: exact canonical name if known (map variants via alias hints); else the name as printed (short form, no honorifics); unknown only if the note gives no name",
    "symbol_witness only if matn missing letter and margin states one",
    "If verdict_label non-null: verdict = verdict_mapping[verdict_label]"
  ]
}
